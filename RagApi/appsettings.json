{
  "ApplicationInsights": {
    "ConnectionString": "[ApplicationInsightsConnectionString]",
    "ApiKey": "[ApplicationInsightsApiKey]"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=DESKTOP-8GN8JDC\\SQLEXPRESS;Initial Catalog=RagApi;Integrated Security=True;Trusted_Connection=true;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "AzureBlobStorage": "[AzureBlobStorageConnectionString]",
    "ServiceBus": "[ServiceBusConnectionString]"
  },
  "Azure": {
    "FormRecognizer": {
      "Endpoint": "[FormRecognizerEndpoint]",
      "Key": "[FormRecognizerKey]"
    },
    "Search": {
      "Endpoint": "[AzureSearchEndpoint]",
      "IndexName": "pdf-documents",
      "Key": "[AzureSearchKey]"
    },
    "OpenAI": {
      "Endpoint": "[AzureOpenAIEndpoint]",
      "Key": "[AzureOpenAIKey]",
      "EmbeddingDeployment": "text-embedding-ada-002",
      "ChatDeployment": "gpt-35-turbo"
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "[YourTenantId]",
    "ClientId": "[YourClientId]",
    "ClientSecret": "[YourClientSecret]",
    "Scope": "https://graph.microsoft.com/.default",
    "TokenExpirationInMinutes": 120,
    "Groups": {
      "Admin": "[AdminGroupId]",
      "User": "[UserGroupId]"
    }
  },
  "OpenAI": {
    "MaxHistoryMessages": 10
  },
  "Application": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "DefaultSystemPromptName": "HR Job Matching",
    "DocumentChunkSize": 1000,
    "VectorDimensions": 1536,
    "MinimumSearchScore": 0.5
  },
  "Security": {
    "TokenKey": "[YourSecretTokenKey]",
    "TokenExpirationMinutes": 60,
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://yourappdomain.com"
    ]
  }
}
